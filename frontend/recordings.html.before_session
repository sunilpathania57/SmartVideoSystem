<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Recording History - Smart Video Management System</title>

    <link rel="stylesheet" href="/static/style.css?v=20260921">

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #222;
        }

        body {
            min-height: 100vh;
        }

        .site-header {
            position: relative;
            z-index: 5000;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
            min-height: 68px;
            padding: 12px 22px;
            background: #1f2937;
            color: #fff;
        }

        .header-title h1 {
            margin: 0 0 3px;
            color: #fff;
            font-size: 23px;
        }

        .header-title p {
            margin: 0;
            color: #dbe2ea;
            font-size: 13px;
        }

        .top-menu {
            position: relative;
            z-index: 6000;
            margin-left: auto;
        }

        .menu-button {
            min-width: 105px;
            height: 38px;
            padding: 0 15px;
            border: 1px solid #4b5563;
            border-radius: 7px;
            background: #374151;
            color: #fff;
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
        }

        .menu-button:hover,
        .menu-button.active {
            background: #2563eb;
        }

        .menu-panel {
            position: absolute;
            top: 46px;
            right: 0;
            width: 220px;
            display: none;
            padding: 6px 0;
            background: #fff;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            box-shadow: 0 8px 24px rgba(0,0,0,.22);
            overflow: hidden;
            z-index: 7000;
        }

        .menu-panel.show {
            display: block;
        }

        .menu-panel a {
            display: block;
            padding: 11px 14px;
            color: #111827;
            text-decoration: none;
            font-size: 14px;
        }

        .menu-panel a:hover {
            background: #f3f4f6;
            color: #2563eb;
        }

        main {
            max-width: 1450px;
            margin: 14px auto;
            padding: 0 16px;
        }

        .card {
            margin-bottom: 12px;
            padding: 14px 16px;
            background: #fff;
            border-radius: 9px;
            box-shadow: 0 2px 7px rgba(0,0,0,.07);
        }

        .heading-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .card h2 {
            margin: 0 0 4px;
            font-size: 19px;
        }

        .page-description {
            margin: 0;
            color: #6b7280;
            font-size: 13px;
        }

        .recording-filters {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr auto;
            gap: 8px;
            margin-bottom: 10px;
        }

        input,
        select {
            min-width: 0;
            width: 100%;
            padding: 8px 10px;
            border: 1px solid #cfd4da;
            border-radius: 6px;
            background: #fff;
            font-size: 13px;
        }

        button {
            padding: 8px 12px;
            border: 0;
            border-radius: 6px;
            background: #2563eb;
            color: #fff;
            cursor: pointer;
            font-size: 13px;
        }

        button:hover {
            opacity: .9;
        }

        .recording-list-scroll {
            max-height: calc(100vh - 245px);
            overflow-y: auto;
            padding-right: 3px;
        }

        /* Compact LIST format - one recording per row */
        .recording-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            min-height: 62px;
            padding: 8px 10px;
            margin-bottom: 6px;
            border: 1px solid #d9dee5;
            border-radius: 7px;
            background: #f8fafc;
        }

        .recording-main {
            min-width: 0;
            flex: 1;
        }

        .recording-title {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 3px;
            font-size: 13px;
        }

        .recording-status {
            padding: 2px 7px;
            border-radius: 10px;
            font-size: 10px;
            font-weight: 700;
            background: #dcfce7;
            color: #166534;
        }

        .recording-status.recording {
            background: #fee2e2;
            color: #991b1b;
        }

        .recording-status.failed {
            background: #fef3c7;
            color: #92400e;
        }

        .recording-details {
            display: flex;
            align-items: center;
            gap: 16px;
            flex-wrap: nowrap;
            min-width: 0;
            color: #374151;
            font-size: 11px;
        }

        .recording-details span {
            white-space: nowrap;
        }

        .recording-file {
            max-width: 330px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .recording-actions {
            display: flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .recording-actions button,
        .recording-actions a {
            display: inline-block;
            padding: 7px 10px;
            border: 0;
            border-radius: 5px;
            font-size: 12px;
            text-decoration: none;
            white-space: nowrap;
        }

        .recording-actions button {
            background: #2563eb;
            color: #fff;
        }

        .recording-actions a {
            background: #374151;
            color: #fff;
        }

        @media (max-width: 1000px) {

            .recording-details {
                flex-wrap: wrap;
                gap: 4px 12px;
            }

            .recording-file {
                max-width: 250px;
            }

        }

        @media (max-width: 700px) {

            .site-header {
                padding: 10px 12px;
            }

            .header-title h1 {
                font-size: 18px;
            }

            .recording-filters {
                grid-template-columns: 1fr;
            }

            .recording-item {
                align-items: flex-start;
                flex-direction: column;
            }

            .recording-actions {
                width: 100%;
            }

        }

    </style>

</head>

<body>

<header class="site-header">

    <div class="header-title">
        <h1>Smart Video Management System</h1>
        <p>Recording History</p>
    </div>

    <div class="top-menu">

        <button
            type="button"
            id="menuToggle"
            class="menu-button"
            aria-expanded="false"
            aria-controls="menuPanel"
        >
            ☰ Menu
        </button>

        <div id="menuPanel" class="menu-panel">
            <a href="/">🖥 Dashboard</a>
            <a href="/add-camera">📷 Add Camera</a>
            <a href="/recording-history">🎥 Recording History</a>
        </div>

    </div>

</header>

<main>

    <section class="card">

        <div class="heading-row">
            <div>
                <h2>Recording History</h2>
                <p class="page-description">
                    New recordings appear automatically. Newest recordings are shown first.
                </p>
            </div>
        </div>

    </section>

    <section class="card">

        <div class="recording-filters">

            <input
                type="text"
                id="recordingSearch"
                placeholder="Search filename..."
            >

            <input
                type="number"
                id="recordingCameraFilter"
                placeholder="Camera ID"
                min="1"
            >

            <select id="recordingStatusFilter">
                <option value="">All Status</option>
                <option value="completed">Completed</option>
                <option value="recording">Recording</option>
                <option value="failed">Failed</option>
            </select>

            <button
                type="button"
                id="clearRecordingFilters"
            >
                Clear Filters
            </button>

        </div>

        <div id="recordingList" class="recording-list-scroll">
            <p>Loading recordings...</p>
        </div>

    </section>

</main>

<script>
(function () {

    const toggle =
        document.getElementById("menuToggle");

    const panel =
        document.getElementById("menuPanel");

    if (!toggle || !panel) {
        return;
    }

    toggle.addEventListener(
        "click",
        function (event) {

            event.stopPropagation();

            const open =
                panel.classList.toggle("show");

            toggle.classList.toggle(
                "active",
                open
            );

            toggle.setAttribute(
                "aria-expanded",
                String(open)
            );

        }
    );

    document.addEventListener(
        "click",
        function (event) {

            if (
                !panel.contains(event.target) &&
                !toggle.contains(event.target)
            ) {

                panel.classList.remove("show");

                toggle.classList.remove("active");

                toggle.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }

        }
    );

})();
</script>

<script src="/static/app.js?v=20260922"></script>

</body>
</html>
